# Give a Gallon — Supabase client configuration
# These VITE_ values are public browser configuration, not server secrets.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional UI flag for the test-user shortcut. Do not enable in production.
VITE_IS_PREVIEW=false

# Payment/server secrets belong in Supabase Edge Function secrets, never in VITE_ variables:
# PAYPAL_CLIENT_ID
# PAYPAL_SECRET
# PAYPAL_ENV=live
# PAYPAL_WEBHOOK_ID
